<?xml version="1.0" encoding="utf-8"?>
<!--
    The window theme behind the Compose launcher and compatibility screens. Compose paints the
    content, but the platform still owns the window before Compose's first frame and the system bars
    after it, and without a theme matching the palette that window would be the platform's default
    (near-white in light mode, near-black in dark) and flash the wrong colour. This is also the
    Android 9-11 fallback the Compose theme cannot provide: those releases have no Material You and
    no Compose-managed window, so the window colours come from here.

    The game's own theme is AppTheme, in styles.xml: SDLActivity draws its own surface, so it has no
    widgets to theme and stays a bare fullscreen theme.

    The Base style holds the colours so values-night can swap them without repeating the parent, and
    values-v31 can add the splash attributes on top. Nothing here draws a widget: every surface is
    Compose.
-->
<resources>
    <!--
        The window behind both Compose screens. One base, two named children: the screens draw the
        same window today, but they are separate Activities with separate lifecycles, so naming them
        apart means a future change to one (a different cutout mode, a different splash) does not
        silently move the other.

        The bar colours below are the pre-Compose fallback and the Android 9-11 answer. From
        PresentationWindow onwards the window is drawn edge to edge and the bars are transparent, so
        on API 28-34 these colours are visible only for the first frame; on API 35+ the system
        ignores them entirely, which is why the runtime path - not this file - is what must be right.
    -->
    <style name="Theme.ZeroHour.Presentation.Base" parent="android:Theme.Material.Light.NoActionBar">
        <!-- The colour of the window before Compose draws. Matches the light scheme's background,
             so there is no flash between the window and the first frame. -->
        <item name="android:windowBackground">@color/window_background</item>
        <!-- The app bar is @color/window_surface; tint the status bar with it so the strip behind
             the clock matches the bar below it. -->
        <item name="android:statusBarColor">@color/window_surface</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <!-- Dark icons on the light window. windowLightNavigationBar is API 27+; minSdk is 28. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- No title, no action bar: the app bar is Compose's. -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- The launcher: the folder picker, the staging progress and the launch button. -->
    <style name="Theme.ZeroHour.Setup" parent="Theme.ZeroHour.Presentation.Base" />

    <!-- The System Requirements & Device Compatibility screen. -->
    <style name="Theme.ZeroHour.Compatibility" parent="Theme.ZeroHour.Presentation.Base" />
</resources>
