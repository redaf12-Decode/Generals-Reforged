<resources>
    <string name="app_name">Zero Hour Reforged</string>

    <!-- The setup screen: the one screen outside the game. It picks the folder Zero Hour is
         installed in and stages it into a real filesystem path the engine can open. -->
    <string name="setup_title">Zero Hour Reforged</string>
    <string name="setup_subtitle">Command &amp; Conquer Generals Zero Hour, recompiled for Android.</string>
    <string name="setup_explanation">Choose the folder Command &amp; Conquer Generals Zero Hour is installed in (the one with INIZH.big). Its files are copied once into this app\'s own storage so the game can read them; the original files are not changed.</string>
    <string name="setup_select_folder">Choose game folder</string>
    <string name="setup_launch">Start game</string>
    <string name="setup_clear_folder">Forget this folder</string>
    <string name="setup_problem_title">Cannot use this folder</string>

    <!-- The game installation card: what was picked and where the game reads it from. -->
    <string name="setup_install_title">Game installation</string>
    <string name="setup_label_folder">Folder</string>
    <string name="setup_label_data_path">Data path</string>
    <string name="setup_value_no_folder">Not chosen</string>
    <string name="setup_copy_note">The folder is copied once into this app\'s storage; the originals are left untouched. Later launches copy only what changed.</string>

    <!-- Forgetting a folder is destructive enough to confirm: it drops the permission, so the
         player has to pick and copy the folder again. -->
    <string name="setup_clear_confirm_title">Forget this folder?</string>
    <string name="setup_clear_confirm_message">This app will stop reading \"%1$s\" and release its access to it. The copied game data is kept, so choosing the same folder again only copies what changed.</string>
    <string name="setup_clear_confirm_action">Forget folder</string>
    <string name="setup_cancel">Cancel</string>
    <string name="setup_no_picker">This device has no folder picker. Install a file manager that provides one, then try again.</string>
    <string name="setup_staging_failed">Copying the game data did not finish.</string>
    <string name="setup_folder_unreadable">The folder you picked could not be read. Choose it again.</string>

    <string name="setup_status_none">No game folder chosen yet.</string>
    <string name="setup_detail_none">Tap \"Choose game folder\" and pick the folder Zero Hour is installed in.</string>
    <string name="setup_status_staging">Copying the game data…</string>
    <string name="setup_status_permission_lost">Access to \"%1$s\" was withdrawn.</string>
    <string name="setup_detail_permission_lost">The system no longer grants access to the folder you picked. Choose it again.</string>
    <string name="setup_status_invalid">\"%1$s\" has no Zero Hour installation in it.</string>
    <string name="setup_status_incomplete">\"%1$s\" is not a complete Zero Hour folder.</string>
    <string name="setup_detail_no_zero_hour">It has no INIZH.big. Choose the folder Zero Hour is installed in, the one with INIZH.big in it.</string>
    <string name="setup_detail_no_base_game">Zero Hour is there, but not the original Command &amp; Conquer Generals it needs. Copy Generals\' .big files into a folder named ZH_Generals inside the Zero Hour folder (its Textures.big must be there), then choose the Zero Hour folder again.</string>
    <string name="setup_status_ready">Ready: \"%1$s\".</string>
    <string name="setup_detail_staging">The game reads its data from %1$s</string>

    <!-- The System Requirements & Device Compatibility screen, opened from the setup screen. -->
    <string name="compat_button">System requirements</string>
    <string name="compat_title">System requirements</string>

    <string name="compat_group_app">Application requirements</string>
    <string name="compat_group_device">Your device</string>

    <string name="compat_result_compatible">Compatible: all mandatory requirements were verified.</string>
    <string name="compat_result_partial">Partially compatible: no mandatory requirement is known to be missing, but some could not be verified.</string>
    <string name="compat_result_unsupported">Unsupported: a mandatory requirement is missing.</string>
    <string name="compat_result_unable">Unable to verify: the device did not report enough information.</string>
    <string name="compat_performance_note">Technical compatibility is not a promise of performance. Meeting the requirements means the renderer can start; frame rate depends on the device and the map.</string>

    <!-- Shared design-system strings: the status vocabulary and the generic action labels. These
         are read by components, so they must stay independent of any one screen's wording. -->
    <string name="status_success">Success</string>
    <string name="status_warning">Warning</string>
    <string name="status_danger">Error</string>
    <string name="status_info">Information</string>
    <string name="status_neutral">Not reported</string>

    <string name="action_back">Back</string>
    <string name="action_dismiss">Dismiss</string>
    <string name="action_in_progress">In progress</string>

    <!-- Progress announcements. The determinate one is a live region, so it is a short sentence the
         screen reader can read out repeatedly without becoming tiring. -->
    <string name="progress_announcement">%1$d%% complete</string>
    <string name="progress_indeterminate">Copying, time remaining unknown</string>

    <!-- The launcher's action group heading. -->
    <string name="setup_group_actions">Game folder</string>

    <!-- The appearance preference: light, dark, or follow the device. -->
    <string name="appearance_title">Appearance</string>
    <string name="appearance_system">Follow system</string>
    <string name="appearance_light">Light</string>
    <string name="appearance_dark">Dark</string>
    <string name="appearance_dynamic_color">Use wallpaper colours</string>
    <string name="appearance_dynamic_color_unavailable">Wallpaper colours need Android 12 or newer.</string>

    <!-- The compatibility screen's field labels and formatted values, so the screen itself holds no
         user-visible English. The technical values come from AndroidRequirements. -->
    <string name="compat_result_summary">Every mandatory requirement is listed below with its result.</string>
    <string name="compat_label_android">Android</string>
    <string name="compat_value_android">%1$s or newer.</string>
    <string name="compat_label_cpu">CPU</string>
    <string name="compat_value_cpu">%1$s (64-bit ARM) only.</string>
    <string name="compat_label_graphics">Graphics</string>
    <string name="compat_value_vulkan_floor">%1$s or newer. There is no OpenGL ES fallback.</string>
    <string name="compat_label_optional_vulkan">Optional Vulkan features</string>
    <string name="compat_value_optional_vulkan">Dropped if absent: %1$s.</string>
    <string name="compat_label_gpus">GPUs</string>
    <string name="compat_label_ram">RAM</string>
    <string name="compat_value_ram">%1$s GB minimum, %2$s GB recommended (provisional; no verified figure).</string>
    <string name="compat_label_storage">Storage</string>
    <string name="compat_label_min_processor">Minimum processor</string>
    <string name="compat_label_recommended_processor">Recommended processor</string>

    <string name="compat_label_manufacturer">Manufacturer</string>
    <string name="compat_label_model">Model</string>
    <string name="compat_label_android_version">Android version</string>
    <string name="compat_label_abis">CPU ABIs</string>
    <string name="compat_label_total_ram">Total RAM</string>
    <string name="compat_value_gb">%1$s GB</string>
    <string name="compat_value_not_reported">not reported</string>

    <string name="compat_label_vulkan">Vulkan</string>
    <string name="compat_vulkan_present">Vulkan hardware reported.</string>
    <string name="compat_vulkan_api_version">Advertised API version: %1$s.</string>
    <string name="compat_vulkan_api_version_unknown">Advertised API version: not exposed by the platform API.</string>
    <string name="compat_vulkan_absent">No Vulkan hardware reported.</string>

    <!-- The five words the screen uses for how much is known about one fact. Each is a status
         chip on its own row, so the difference between them is read, not inferred from a colour. -->
    <string name="evidence_verified">Verified</string>
    <string name="evidence_unsupported">Unsupported</string>
    <string name="evidence_unable_to_verify">Unable to verify</string>
    <string name="evidence_not_reported">Not reported</string>
    <string name="evidence_not_available">Not available</string>

    <string name="compat_label_api_level">API level</string>
    <string name="compat_label_vulkan_extensions">Required Vulkan extensions</string>
    <string name="compat_label_vulkan_features">Required Vulkan features</string>

    <string name="compat_group_unverified">Not verified</string>
    <string name="compat_group_checks">Compatibility checks</string>

    <string name="compat_label_gpu_model">GPU model and vendor</string>
    <string name="compat_label_vulkan_ids">Vulkan vendor and device IDs</string>

    <string name="compat_unverified_gpu">The Android platform API does not expose the Vulkan physical-device name, so this app never infers a GPU from a manufacturer, model or SoC family. The engine reads the real adapter name when it starts.</string>
    <string name="compat_unverified_features">The mandatory Vulkan features cannot be read through the Android platform API on any device. The engine checks them when it creates the device, and stops with a message if one is missing.</string>
    <string name="compat_unverified_extensions">Per-extension support cannot be read through the Android platform API. Only the Vulkan version and the optional-feature level are reported; whether a specific extension is present is checked by the engine at startup.</string>
    <string name="compat_unverified_ids">The vendor ID, device ID and driver version are not exposed by the platform API.</string>
    <string name="compat_vulkan_level_not_reported">Optional-feature level: not reported.</string>
    <string name="compat_vulkan_level">Optional-feature level: %1$d.</string>
</resources>
