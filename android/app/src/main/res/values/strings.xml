    <string name="compat_result_unsupported">Unsupported: a mandatory requirement is missing.</string>
    <string name="compat_result_unable">Unable to verify: the device did not report enough information.</string>
    <string name="compat_performance_note">Technical compatibility is not a promise of performance. Meeting the requirements means the renderer can start; frame rate depends on the device and the map.</string>

